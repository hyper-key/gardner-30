(set-logic QF_LIA)
(define-fun abs ((v Int)) Int (ite (< v 0) (- v) v))
(define-fun dist ((x Int) (y Int)) Int
  (ite (< (abs (- x y)) (- 6 (abs (- x y))))
       (abs (- x y)) (- 6 (abs (- x y)))))
(declare-const x0 Int)
(declare-const x1 Int)
(declare-const x2 Int)
(declare-const x3 Int)
(declare-const x4 Int)
(declare-const x5 Int)
(assert (and (<= 0 x0) (< x0 6)))
(assert (and (<= 0 x1) (< x1 6)))
(assert (and (<= 0 x2) (< x2 6)))
(assert (and (<= 0 x3) (< x3 6)))
(assert (and (<= 0 x4) (< x4 6)))
(assert (and (<= 0 x5) (< x5 6)))
(assert (distinct x0 x1 x2 x3 x4 x5))
(assert (= x0 0))
(assert (= x1 3))
(assert (= x2 1))
(assert (= x3 2))
(assert (= x4 4))
(assert (= x5 5))
(assert (= (+ (ite (= (dist x0 x1) 1) 1 0) (ite (= (dist x1 x2) 1) 1 0) (ite (= (dist x2 x3) 1) 1 0) (ite (= (dist x3 x4) 1) 1 0) (ite (= (dist x4 x5) 1) 1 0) (ite (= (dist x5 x0) 1) 1 0)) 2))
(assert (= (+ (ite (= (dist x0 x1) 2) 1 0) (ite (= (dist x1 x2) 2) 1 0) (ite (= (dist x2 x3) 2) 1 0) (ite (= (dist x3 x4) 2) 1 0) (ite (= (dist x4 x5) 2) 1 0) (ite (= (dist x5 x0) 2) 1 0)) 2))
(assert (= (+ (ite (= (dist x0 x1) 3) 1 0) (ite (= (dist x1 x2) 3) 1 0) (ite (= (dist x2 x3) 3) 1 0) (ite (= (dist x3 x4) 3) 1 0) (ite (= (dist x4 x5) 3) 1 0) (ite (= (dist x5 x0) 3) 1 0)) 1))
(check-sat)
