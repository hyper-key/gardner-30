(set-logic QF_LIA)
(define-fun abs ((v Int)) Int (ite (< v 0) (- v) v))
(define-fun dist ((x Int) (y Int)) Int
  (ite (< (abs (- x y)) (- 6 (abs (- x y))))
       (abs (- x y)) (- 6 (abs (- x y)))))
(declare-const x0 Int)
(declare-const x1 Int)
(declare-const x2 Int)
(declare-const x3 Int)
(declare-const x4 Int)
(declare-const x5 Int)
(assert (and (<= 0 x0) (< x0 6)))
(assert (and (<= 0 x1) (< x1 6)))
(assert (and (<= 0 x2) (< x2 6)))
(assert (and (<= 0 x3) (< x3 6)))
(assert (and (<= 0 x4) (< x4 6)))
(assert (and (<= 0 x5) (< x5 6)))
(assert (not (= (dist 0 5) 1)))
(check-sat)
